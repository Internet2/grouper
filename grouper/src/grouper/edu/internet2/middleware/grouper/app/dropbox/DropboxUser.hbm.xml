<hibernate-mapping package="edu.internet2.middleware.grouper.app.dropbox" default-lazy="false">
  <class name="DropboxUser" table="mock_dropbox_user">

    <meta attribute="implement-equals">true</meta>
    <meta attribute="session-method">Hib3DAO.getSession();</meta>

    <id name="id" column="id">
      <generator class="assigned" />
    </id>

    <property name="email" column="email" />
    <property name="externalId" column="external_id" />
    <property name="givenName" column="given_name" />
    <property name="surname" column="surname" />
    <property name="status" column="status" />
    <property name="accountId" column="account_id" />
    <property name="adminRole" column="admin_role" />

  </class>
</hibernate-mapping>
