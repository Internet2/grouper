<hibernate-mapping package="edu.internet2.middleware.grouper.app.assetSonarProvisioning" default-lazy="false">
  <class name="AssetSonarMember" table="mock_asset_sonar_member">

    <meta attribute="implement-equals">true</meta>
    <meta attribute="session-method">Hib3DAO.getSession();</meta>

    <id name="id" column="id">
      <generator class="assigned" />
    </id>

    <property name="email" column="email" />
    <property name="firstName" column="first_name" />
    <property name="lastName" column="last_name" />
    <property name="employeeId" column="employee_id" />
    <property name="employeeIdentificationNumber" column="employee_identification_number" />
    <property name="roleId" column="role_id" />
    <property name="status" column="status" />
    <property name="externalId" column="external_id" />

  </class>
</hibernate-mapping>
